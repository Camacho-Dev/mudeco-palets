# Database
# Local SQLite (dev): file:./dev.db  — requiere provider = "sqlite" en schema
# Producción / Neon:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth (genera uno: openssl rand -base64 32)
AUTH_SECRET="cambia-este-secreto"
AUTH_URL="http://localhost:3000"

COMPANY_NAME="Mudeco Palets"
COMPANY_TAX_ID="130000000"

# Pago online (Stripe) — opcional hasta que lo actives
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_APP_URL="https://mudeco-palets.vercel.app"

# Autenticación con Google (OAuth) — opcional
# GOOGLE_CLIENT_ID="tu-cliente.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="tu-secreto-google"

# Correo de facturas (SMTP) — requerido para enviar PDF al pagar online
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu@correo.com"
# SMTP_PASS="app-password"
# SMTP_FROM="Mudeco Palets <ventas@mudecopalets.com>"
# Avisos de pedidos web al equipo (opcional; por defecto usa email de Empresa)
# STAFF_NOTIFY_EMAIL="taller@mudecopalets.com"

